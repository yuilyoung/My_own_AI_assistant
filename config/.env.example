# Examples only: this file is NOT loaded automatically. Set process environment variables.
LLM_PROVIDER=demo
# none | supertonic (three Korean voices) | melo (one Korean voice)
TTS_PROVIDER=none
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
MELO_URL=http://127.0.0.1:8766
# MELO_TOKEN=generate-a-private-random-token-and-share-only-between-local-processes
SUPERTONIC_URL=http://127.0.0.1:8767
# SUPERTONIC_TOKEN=generate-a-private-token-and-share-with-the-local-worker
# Worker only: SUPERTONIC_MODEL_DIR=/path/to/sherpa-onnx-supertonic-tts-int8-2026-03-06
# ASSISTANT_TOKEN is generated into .local-data/access-token if not supplied.

# Optional Korean recognition; no automatic model/binary download.
STT_PROVIDER=none
# WHISPER_CLI=C:\tools\whisper.cpp\build\bin\Release\whisper-cli.exe
# WHISPER_MODEL=C:\tools\whisper.cpp\models\ggml-small.bin

# Optional explicit frontend; default prefers built apps/web/dist, else diagnostics.
# ASSISTANT_WEB_DIR=apps/diagnostics

# Optional cloud chat, available alongside local Ollama. Never commit real keys.
# LLM_PROVIDER selects the default: demo | ollama | cloud.
# LOCAL_LLM_ENABLED=true enables the local option even when cloud/demo is default.
# CLOUD_API_KEY=set-only-in-your-local-process-or-Render-secrets
# CLOUD_MODEL=exact-model-name-from-your-provider
CLOUD_BASE_URL=https://api.openai.com/v1
# Optional same-origin licensed avatar export and runtime directory.
# The directory root contains Haru/Haru.model3.json and runtime/adapter.js.
# ASSISTANT_AVATAR_DIR=/absolute/path/to/private/avatar-assets
