{
  "name": "my-own-ai-assistant-quality",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "format": "prettier --write \"apps/diagnostics/**/*.{mjs,html,css}\" eslint.config.mjs package.json package-lock.json",
    "format:check": "prettier --check \"apps/diagnostics/**/*.{mjs,html,css}\" eslint.config.mjs package.json package-lock.json",
    "lint": "eslint apps/diagnostics eslint.config.mjs --max-warnings 0",
    "test": "node --test",
    "test:ci": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/javascript-junit.xml --test-reporter=lcov --test-reporter-destination=reports/javascript-coverage.lcov"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.7.4"
  }
}
