{
  "name": "my-own-ai-assistant-quality",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write \"apps/diagnostics/**/*.{mjs,html,css}\" eslint.config.mjs package.json package-lock.json",
    "format:check": "prettier --check \"apps/diagnostics/**/*.{mjs,html,css}\" eslint.config.mjs package.json package-lock.json",
    "lint": "eslint apps/diagnostics eslint.config.mjs --max-warnings 0",
    "test": "node --test",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/tests/**\" --test-reporter=junit --test-reporter-destination=reports/javascript-junit.xml --test-reporter=lcov --test-reporter-destination=reports/javascript-coverage.lcov"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.7.4"
  }
}
